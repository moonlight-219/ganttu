  "dependencies": {
    "@gantt/core": "workspace:*",
    "@gantt/vue-gantt": "workspace:*",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
