{
  "name": "gantt",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @gantt/playground dev",
    "lint": "tsc -p tsconfig.base.json --noEmit",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "pnpm --filter @gantt/playground benchmark"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @gantt/playground dev",
    "lint": "tsc -p tsconfig.base.json --noEmit",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "pnpm --filter @gantt/playground benchmark",
    "publish": "pnpm -r publish",
    "publish:force": "pnpm publish --no-git-checks"
  },
  "packageManager": "pnpm@9.15.0"
}
